{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datus.ai/schemas/tableau/source-bindings-v1.json",
  "title": "Explicit native Prep source bindings",
  "type": "object",
  "propertyNames": {"pattern": "^transform:.+:.+$"},
  "additionalProperties": {
    "type": "object",
    "required": ["table"],
    "properties": {
      "table": {"type": "string", "minLength": 1, "description": "Qualified identifier validated by the SQL generator; SQL fragments are rejected."},
      "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Optional exact ordered native source field names. This validates the native schema; it does not override it."}
    },
    "additionalProperties": false
  }
}
